diff --git a/src/ops/launcher/diag_nonfinite.cu b/src/ops/launcher/diag_nonfinite.cu
new file mode 100644
index 00000000..bf4bc1c1
--- /dev/null
+++ b/src/ops/launcher/diag_nonfinite.cu
@@ -0,0 +1,100 @@
+#include "ninfer/ops/diag_nonfinite.h"
+
+#include "core/device.h"
+
+#include <cuda_bf16.h>
+
+#include <climits>
+#include <cstdio>
+#include <cstring>
+
+namespace ninfer::ops {
+namespace {
+
+constexpr int kColumns = 65;
+constexpr int kLayers  = 50;
+constexpr int kStages  = 8;
+constexpr int kSlots   = kColumns * kLayers * kStages;
+int enqueued[kColumns]   = {};
+int skipped              = 0;
+
+struct Record {
+    int* host   = nullptr;
+    int* device = nullptr;
+};
+
+Record& record() {
+    static Record r = [] {
+        Record out;
+        cudaStreamCaptureMode mode = cudaStreamCaptureModeRelaxed;
+        CUDA_CHECK(cudaThreadExchangeStreamCaptureMode(&mode));
+        void* host = nullptr;
+        CUDA_CHECK(cudaHostAlloc(&host, sizeof(int) * kSlots, cudaHostAllocMapped));
+        void* device = nullptr;
+        CUDA_CHECK(cudaHostGetDevicePointer(&device, host, 0));
+        CUDA_CHECK(cudaThreadExchangeStreamCaptureMode(&mode));
+        out.host   = static_cast<int*>(host);
+        out.device = static_cast<int*>(device);
+        for (int i = 0; i < kSlots; ++i) { out.host[i] = INT_MAX; }
+        return out;
+    }();
+    return r;
+}
+
+__global__ void scan_kernel(const __nv_bfloat16* data, int rows, int* slot) {
+    const int column = static_cast<int>(blockIdx.x);
+    bool bad         = false;
+    for (int r = static_cast<int>(threadIdx.x); r < rows; r += static_cast<int>(blockDim.x)) {
+        const float v = __bfloat162float(data[static_cast<long long>(column) * rows + r]);
+        if (!isfinite(v)) { bad = true; }
+    }
+    if (__syncthreads_or(bad) && threadIdx.x == 0) { atomicMin_system(slot, column); }
+}
+
+} // namespace
+
+void diag_check_nonfinite(const Tensor& tensor, int layer, int stage, cudaStream_t stream) {
+    if (tensor.dtype != DType::BF16 || tensor.data == nullptr || !tensor.is_contiguous()) {
+        ++skipped;
+        return;
+    }
+    const int rows    = static_cast<int>(tensor.ne[0]);
+    const int columns = rows == 0 ? 0 : static_cast<int>(tensor.numel() / rows);
+    if (columns <= 0 || columns >= kColumns || layer < 0 || layer >= kLayers || stage < 0 ||
+        stage >= kStages) {
+        ++skipped;
+        return;
+    }
+    ++enqueued[columns];
+    int* slot = record().device + (columns * kLayers + layer) * kStages + stage;
+    scan_kernel<<<columns, 256, 0, stream>>>(static_cast<const __nv_bfloat16*>(tensor.data), rows,
+                                             slot);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void diag_report(const char* label) {
+    Record& r = record();
+    int hits  = 0;
+    for (int c = 0; c < kColumns; ++c) {
+        for (int l = 0; l < kLayers; ++l) {
+            for (int s = 0; s < kStages; ++s) {
+                int& v = r.host[(c * kLayers + l) * kStages + s];
+                if (v == INT_MAX) continue;
+                std::fprintf(stderr, "[diag %s] columns=%d layer=%d stage=%d first_bad_column=%d\n",
+                             label, c, l, s, v);
+                v = INT_MAX;
+                ++hits;
+            }
+        }
+    }
+    std::fprintf(stderr, "[diag %s] %d non-finite records\n", label, hits);
+    for (int c = 0; c < kColumns; ++c) {
+        if (enqueued[c] != 0) {
+            std::fprintf(stderr, "[diag %s] scans enqueued at columns=%d: %d\n", label, c,
+                         enqueued[c]);
+        }
+    }
+    std::fprintf(stderr, "[diag %s] scans skipped (dtype, layout or width): %d\n", label, skipped);
+}
+
+} // namespace ninfer::ops
